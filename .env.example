# MONGODB_URI: MongoDB connection string for persisting registered users,
# encrypted vault files, encrypted chat envelopes, and audit activity logs.
# Configure this in the Secrets panel before deploying.
MONGODB_URI=

# MONGODB_DB_NAME: Optional database name (defaults to "cipherhall").
MONGODB_DB_NAME=cipherhall

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"
